<?xml version="1.0" encoding="utf-8"?>
<!--
    Black radio glyph, centered in the adaptive icon's safe zone (the inner ~66dp circle of the
    108dp canvas that survives every launcher mask shape) so it never gets clipped.

    Depicts a classic portable radio: a carrying handle, a body, a large speaker and two small
    control knobs (a tuning dial + a grille slot) - deliberately without any antenna, since a
    thin antenna line reads poorly at small icon sizes and was previously mistaken for "two
    antennas". The speaker/knobs/slot are real holes cut out of the body path (via
    fillType="evenOdd"), not just differently colored shapes, so the glyph still reads correctly
    when Android renders it as a single-color themed/monochrome icon (Android 13+).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Source glyph is drawn in a 24x24 space, then scaled/centered into the 108x108 canvas. -->
    <group
        android:translateX="21"
        android:translateY="21"
        android:scaleX="2.75"
        android:scaleY="2.75">
        <!-- Carrying handle. -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="#FF000000"
            android:strokeWidth="1.6"
            android:strokeLineCap="round"
            android:pathData="M7.5,7 C7.5,3.5 9.5,1.8 12,1.8 C14.5,1.8 16.5,3.5 16.5,7" />
        <!-- Body, with the speaker, tuning knob and grille slot punched out as real holes. -->
        <path
            android:fillColor="#FF000000"
            android:fillType="evenOdd"
            android:pathData="M5.5,7
                H18.5
                A2.5,2.5 0 0 1 21,9.5
                V17.5
                A2.5,2.5 0 0 1 18.5,20
                H5.5
                A2.5,2.5 0 0 1 3,17.5
                V9.5
                A2.5,2.5 0 0 1 5.5,7
                Z
                M5.3,14
                a3.2,3.2 0 1,0 6.4,0
                a3.2,3.2 0 1,0 -6.4,0
                M14.9,11.5
                a1.6,1.6 0 1,0 3.2,0
                a1.6,1.6 0 1,0 -3.2,0
                M15.2,14.8
                H17.8
                A0.7,0.7 0 0 1 18.5,15.5
                A0.7,0.7 0 0 1 17.8,16.2
                H15.2
                A0.7,0.7 0 0 1 14.5,15.5
                A0.7,0.7 0 0 1 15.2,14.8
                Z" />
    </group>
</vector>

