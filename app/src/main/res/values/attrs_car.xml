    "com.google.android.gms.car.application.theme" meta-data in AndroidManifest.xml.
    They are declared here so the theme below compiles inside this app.
-->
<resources>
    <attr name="carColorPrimary" format="color" />
    <attr name="carColorPrimaryDark" format="color" />
    <attr name="carColorAccent" format="color" />
</resources>

